# Model weights, LoRA adapters and training data stay out of Git.
models/*
!models/.gitkeep
adapters/*
!adapters/.gitkeep
data/*
!data/.gitkeep
*.safetensors
*.gguf
*.npz

# Exception: the best adapter of the law-QA experiment (22 MB). It was trained on a public
# Apache-2.0 dataset, so it is safe to share and lets anyone try the fine-tuned model.
!adapters/law-qa-r8-best/
!adapters/law-qa-r8-best/adapters.safetensors
!adapters/law-qa-r8-best/adapter_config.json

# Exception: the law-QA data (Apache-2.0, public, ~6 MB): the prepared train/valid/test files,
# the RAG corpus and the raw download, so the experiment can be inspected and re-run as is.
!data/law-qa/
!data/raw/
data/raw/*
!data/raw/turkish_law_qa/

# Python
.venv/
__pycache__/
*.pyc

# Node / Vite
node_modules/
frontend/dist/

# Secrets and local settings
.env
.env.*

# macOS
.DS_Store
